# Copia este archivo a .env.local y completá los valores reales para
# desarrollar en tu máquina. .env.local nunca se sube al repositorio.

# --- Base de datos (Redis) ---
#
# Guarda citas, clientas, equipo y servicios, y hace que se sincronicen
# entre todos los que abran la agenda. En Vercel: Storage → Marketplace →
# instalá la integración de Redis (Upstash) y conectala a este proyecto —
# las variables se agregan solas, no hay que copiarlas a mano.
#
# Sin estas variables, la agenda muestra un mensaje explicando que falta
# conectar la base de datos, en vez de romperse.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Acceso (usuario y contraseña) ---
#
# Toda la agenda queda detrás de un login. Sin estas variables, se usa el
# usuario y contraseña por defecto (adoramaster2026 / adoraAdios2026!) —
# funciona de una, pero para producción se recomienda fijar estas tres
# variables en Vercel con tus propios valores.
ADORA_AUTH_USER=
ADORA_AUTH_PASSWORD=
# Cadena larga y al azar — firma la sesión para que no se pueda falsificar
# la cookie de acceso. Generá una con: openssl rand -hex 32
ADORA_AUTH_SECRET=
